knitr::opts_chunk$set(cache = TRUE)
library(readr)
library(dplyr)
library(ggplot2)
library(tidyr)
winequality <- read.csv("http://archive.ics.uci.edu/ml/machine-learning-databases/wine-quality/winequality-white.csv", sep=";")
winequality <- winequality  %>% mutate(quality = as.character(quality))
#отразить первые несколько строк --- базовый синтаксис
head(winequality)
#отразить первые несколько строк --- dplyr
glimpse(winequality)
#названия переменных--столбцов
colnames(winequality)
apply(winequality,2,class)
winequality %>% group_by(quality)  %>% summarise(mean(pH), mean(density),  mean(chlorides), mean(alcohol))
winequality  %>% group_by(quality)  %>% summarise(mean(fixed.acidity), mean(citric.acid),  mean(volatile.acidity))
winequality <- winequality %>% mutate(new.quality = cut(as.numeric(quality), breaks = c(2.5,5.5,9.5), labels = c("low", "high")), .keep="all")
winequality %>% select_if(is.numeric)  %>% pivot_longer(1:10, values_to="value", names_to="names") %>%
ggplot() + geom_histogram(aes(x = value), bins = 20, colour = "black", fill = "white") + facet_wrap(~ names, scales = "free", ncol=3)
winequality %>% select(residual.sugar, density)  %>% tidyr::pivot_longer(1:2, values_to="value", names_to="names") %>%
ggplot() + geom_histogram(aes(x = value), bins = 100, colour = "black", fill = "white") + facet_wrap(~ names, scales = "free", ncol=3)
which(winequality$density > 1.01)
which(winequality$residual.sugar > 30)
winequality$quality[c(1654, 1664, 2782)]
library(dbscan)
lof <- lof(winequality %>% select(-quality, -new.quality), minPts = 3)
summary(lof)
anomaly_inx <- which(lof==Inf)
ggplot(aes(x=pH, fill = new.quality), data=winequality) +
geom_boxplot() +
labs(x = "pH",title="Зависимость показателя кислотности от качества вина") +
theme_bw()
t.test(winequality$pH ~ winequality$new.quality)
ggplot(aes(x=density, fill = new.quality), data=winequality) +
geom_boxplot() +
labs(x = "Плотность",title="Зависимость показателя плотности от качества вина") +
theme_bw()
t.test(winequality$density ~ winequality$new.quality)
winequality %>% select(density, sulphates, chlorides, volatile.acidity, citric.acid, new.quality) %>% tidyr::pivot_longer(!new.quality, names_to="characteristic", values_to="values") %>% ggplot() +
geom_boxplot(aes(x = characteristic, y = values, fill=new.quality)) + theme_bw()
winequality %>% select(alcohol, residual.sugar, new.quality) %>% tidyr::pivot_longer(!new.quality, names_to="characteristic", values_to="values") %>% ggplot() +
geom_boxplot(aes(x = characteristic, y = values, fill=new.quality)) + theme_bw()
t.test(winequality$citric.acid ~ winequality$new.quality)
t.test(winequality$volatile.acid ~ winequality$new.quality)
t.test(winequality$density ~ winequality$new.quality)
t.test(winequality$alcohol ~ winequality$new.quality)
wilcox.test(winequality$pH[which(winequality$quality==3)], winequality$pH[which(winequality$quality==9)])
library(corrplot)
plotCor <- corrplot(cor(winequality %>% select(-quality, -new.quality)))
cor.test(winequality$alcohol, winequality$density)
cor.test(winequality$sulphates, winequality$chlorides)
M <- Hmisc::rcorr(as.matrix(winequality %>% select(-quality, -new.quality)), type="spearman")
Mr <- M$r
Mp <- as.data.frame(M$P) %>% mutate(across(where(is.numeric), ~replace_na(., 0)))
oldp <- par(cex=.75)
#сущетсвуют и другие пакеты
Mcorr <- corrplot(Mr, p.mat = as.matrix(Mp), sig.level = 0.05, insig = "p-value", tl.cex = 1, tl.col = "black", cl.cex=1)
c <- vector(mode="numeric", length = 1000)
t_func <- function(x, mu){
t_func <- (mean(x)-mu)/(sd(x)/sqrt(length(x)))
}
